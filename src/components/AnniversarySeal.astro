---
// Animated anniversary seal for the home page hero.
// Rotating ring of brass lettering, a number that counts up when it
// scrolls into view, a periodic brass sheen, and a few twinkling sparkles.
// Everything holds still for visitors who prefer reduced motion.
import { site } from "../data/site";

const years = site.yearsCelebrating;
const ringText = `Celebrating ${years} years  ·  Avastar Dressage  ·  Est. ${site.established}  ·  `;
---

<div class="anniv flex items-center gap-5 sm:gap-6">
  <div class="seal relative h-32 w-32 shrink-0 sm:h-36 sm:w-36" aria-hidden="true">
    <!-- Rotating lettered ring -->
    <svg viewBox="0 0 200 200" class="seal-ring absolute inset-0 h-full w-full">
      <defs>
        <path
          id="anniv-ring-path"
          d="M100,100 m-82,0 a82,82 0 1,1 164,0 a82,82 0 1,1 -164,0"
        ></path>
      </defs>
      <circle cx="100" cy="100" r="97" fill="none" stroke="currentColor" stroke-opacity="0.35" stroke-width="1"></circle>
      <text
        class="fill-brass-deep font-body text-[13px] font-bold uppercase tracking-[0.12em]"
      >
        <textPath href="#anniv-ring-path" textLength="510" lengthAdjust="spacing">
          {ringText}
        </textPath>
      </text>
    </svg>

    <!-- Center medallion -->
    <div
      class="medallion absolute inset-[19%] flex flex-col items-center justify-center overflow-hidden rounded-full bg-navy text-cream shadow-lg ring-2 ring-brass ring-offset-2 ring-offset-cream"
    >
      <span
        class="anniv-count font-display text-[2.4rem] font-semibold leading-none sm:text-[2.7rem]"
        data-target={years}
      >
        {years}
      </span>
      <span class="mt-1 text-[0.58rem] font-bold uppercase tracking-[0.24em] text-brass">
        Years
      </span>
      <span class="sheen"></span>
    </div>

    <!-- Sparkles -->
    {
      [
        "left-[2%] top-[6%] h-4 w-4 [animation-delay:0s]",
        "right-[0%] top-[22%] h-3 w-3 [animation-delay:1.1s]",
        "bottom-[4%] right-[10%] h-5 w-5 [animation-delay:2.2s]",
        "bottom-[18%] left-[-4%] h-2.5 w-2.5 [animation-delay:3s]",
      ].map((pos) => (
        <svg viewBox="0 0 24 24" class={`sparkle absolute text-brass ${pos}`}>
          <path
            fill="currentColor"
            d="M12 0c.9 7.4 3.6 10.1 12 12-8.4 1.9-11.1 4.6-12 12-.9-7.4-3.6-10.1-12-12C8.4 10.1 11.1 7.4 12 0Z"
          />
        </svg>
      ))
    }
  </div>

  <div>
    <p class="eyebrow">{site.established} to {site.established + years}</p>
    <p class="mt-1.5 font-display text-2xl font-medium leading-tight text-navy sm:text-[1.7rem]">
      Celebrating {years} years!
    </p>
    <p class="mt-2 max-w-sm text-[0.95rem] leading-relaxed text-muted">
      Founded at Lepore Farm in {site.established}. Thank you to every horse
      and rider who has been part of the story.
    </p>
  </div>
</div>

<style>
  /* Nothing moves until the script adds .is-visible, which happens once the
     whole seal block is on screen. With JS on, the seal waits hidden so its
     pop-in is the reveal; with JS off it just shows. */
  .seal {
    color: var(--color-brass);
  }

  @media (scripting: enabled) {
    .seal {
      opacity: 0;
    }
  }

  .anniv.is-visible .seal {
    opacity: 1;
    animation: seal-pop 900ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .anniv.is-visible .seal-ring {
    animation: seal-spin 32s linear 900ms infinite;
  }

  .anniv.is-visible .seal:hover .seal-ring {
    animation-duration: 8s;
  }

  .sheen {
    position: absolute;
    inset: -20%;
    background: linear-gradient(
      115deg,
      transparent 40%,
      rgb(255 236 200 / 0.35) 50%,
      transparent 60%
    );
    transform: translateX(-120%);
    pointer-events: none;
  }

  .anniv.is-visible .sheen {
    animation: seal-sheen 5s ease-in-out 1.4s infinite;
  }

  .sparkle {
    opacity: 0;
  }

  .anniv.is-visible .sparkle {
    animation-name: seal-twinkle;
    animation-duration: 4s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  @keyframes seal-pop {
    from {
      opacity: 0;
      transform: scale(0.6) rotate(-20deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  @keyframes seal-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes seal-sheen {
    0% {
      transform: translateX(-120%);
    }
    35%,
    100% {
      transform: translateX(120%);
    }
  }

  @keyframes seal-twinkle {
    0%,
    100% {
      opacity: 0;
      transform: scale(0.4) rotate(0deg);
    }
    15% {
      opacity: 1;
      transform: scale(1) rotate(45deg);
    }
    35% {
      opacity: 0;
      transform: scale(0.4) rotate(90deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .seal,
    .anniv.is-visible .seal,
    .anniv.is-visible .seal-ring,
    .anniv.is-visible .sheen,
    .anniv.is-visible .sparkle {
      animation: none;
    }
    .seal {
      opacity: 1;
    }
    .sparkle {
      opacity: 0.8;
    }
  }
</style>

<script>
  // Start everything (pop-in, spin, sheen, sparkles, count-up) only once the
  // whole seal block is fully inside the viewport.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const countUp = (el: HTMLElement) => {
    const target = Number(el.dataset.target);
    if (reduce || !target) return;
    const duration = 1400;
    const start = performance.now() + 300;
    const tick = (now: number) => {
      const t = Math.min(Math.max((now - start) / duration, 0), 1);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = String(Math.round(eased * target));
      if (t < 1) requestAnimationFrame(tick);
    };
    el.textContent = "0";
    requestAnimationFrame(tick);
  };

  document.querySelectorAll<HTMLElement>(".anniv").forEach((block) => {
    const io = new IntersectionObserver(
      (entries) => {
        // 0.99 rather than 1 so sub-pixel rounding can't block the trigger.
        if (!entries.some((e) => e.intersectionRatio >= 0.99)) return;
        io.disconnect();
        block.classList.add("is-visible");
        const count = block.querySelector<HTMLElement>(".anniv-count");
        if (count) countUp(count);
      },
      { threshold: [0.99, 1] },
    );
    io.observe(block);
  });
</script>
